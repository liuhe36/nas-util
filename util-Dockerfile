#
# Dockerfile for youtube-dl
#

FROM jlesage/baseimage-gui:ubuntu-24.04-v4

ENV DEBIAN_FRONTEND=noninteractive
LABEL maintainer="liu"

# intel-media-va-driver-non-free: 开源版 iHD 在 9 代核显上没有 HEVC 编码和 QSV 编码,必须装完整版
# libmfx1: 老 Media SDK 运行时,6~11 代核显走 QSV 靠它;libmfx-gen1.2: 11 代以后的核显
# 用底包自带的 add-pkg 装:底包构建期没有用户组数据库,/var/log 也是指向 /config 的链接,
# 直接 apt-get 会在 fontconfig/systemd 的安装脚本上失败
RUN add-pkg ffmpeg mediainfo \
        intel-media-va-driver-non-free libmfx1 libmfx-gen1.2 vainfo \
        ca-certificates curl wget vim unzip

# yt-dlp_linux 自带 python 和 EJS 脚本;下 YouTube 还需要 JS 运行时,官方推荐 deno
RUN curl -fL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux -o /usr/local/bin/yt-dlp && \
    chmod a+rx /usr/local/bin/yt-dlp && \
    curl -fL https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip -o /tmp/deno.zip && \
    unzip -o /tmp/deno.zip -d /usr/local/bin && rm /tmp/deno.zip && \
    yt-dlp --version && deno --version

ENV LIBVA_DRIVER_NAME=iHD
ENV LANG=C.UTF-8

WORKDIR /data
#COPY startapp.sh /startapp.sh
CMD ["/bin/sh"]
